# Required for the discovery MVP. Create an account at https://tavily.com/
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Optional paths. Defaults are inside this project.
RESUME_PATH=data/resume.pdf
DATABASE_PATH=data/internship_tracker.db

# Later phases (kept here so configuration stays stable):
ANTHROPIC_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth2callback
HUNTER_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
